# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------- RACE engine
# Everything below is server-side only. None of it reaches the browser.
# In AI Studio these are set in Settings → Secrets.

# Claude, which runs the skills.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# Only needed if the key above is org-level rather than workspace-scoped.
# ANTHROPIC_WORKSPACE_ID="wrkspc_..."

# Skill 1, uploaded with RACE-Engine-Skills/integration/upload_skill.py.
# PIN THE VERSION. Running against `latest` means a skill edit silently changes
# production behaviour, including the guards that keep credentials and
# special-category data out of the record.
RACE_SKILL_ID="skill_..."
RACE_SKILL_VERSION="MY_SKILL_VERSION"
# RACE_MODEL="claude-opus-5"

# Identity-resolution vendors. Each is optional — the engine uses whichever are
# configured and records the gap for the rest.
OSINT_INDUSTRIES_API_KEY=""
PREDICTA_API_KEY=""
BTE_API_KEY=""

# Shared token for /api/race/*. Required in production: these endpoints return
# other people's personal data and the app has a public URL.
RACE_ADMIN_TOKEN="MY_LONG_RANDOM_STRING"

# Where run records are written. On Cloud Run the default is ephemeral — point
# this at a mounted volume before treating the records as an audit trail.
# RACE_DATA_DIR="/var/race-data"

# Keep raw vendor payloads in the run record for debugging. Credentials are
# redacted on the way to disk regardless. Off by default.
# RACE_KEEP_RAW="false"
# Put the email address in the run index as well as the subject map. Off by
# default so the operational log is readable without being a list of people.
# RACE_LOG_EMAIL="false"
