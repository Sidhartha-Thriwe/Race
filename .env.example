# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------- RACE engine
# Everything below is server-side only. None of it reaches the browser.
# In AI Studio these are set in Settings → Secrets.

# Claude, which runs the skills.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# Only needed if the key above is org-level rather than workspace-scoped.
# ANTHROPIC_WORKSPACE_ID="wrkspc_..."

# Skill 1, uploaded with RACE-Engine-Skills/integration/upload_skill.py.
# PIN THE VERSION. Running against `latest` means a skill edit silently changes
# production behaviour, including the guards that keep credentials and
# special-category data out of the record.
RACE_SKILL_ID="skill_015XBHz4oHpVhLFNcDtVRVQX"
RACE_SKILL_VERSION="skver_01Y1i4PmpGUB2jiMihw98kTh"
# RACE_MODEL="claude-opus-5"

# Identity-resolution vendors. Each is optional — the engine uses whichever are
# configured and records the gap for the rest.
OSINT_INDUSTRIES_API_KEY=""
PREDICTA_API_KEY=""
BTE_API_KEY=""

# OPTIONAL. Leave it unset and /api/race/* is open to anyone with the URL —
# which means anyone who finds it can spend vendor credits and read stored
# records. Set it to any long random string (openssl rand -hex 24) and the
# routes start requiring an x-race-token header immediately, no code change.
# Worth setting before this URL is shared or left running.
# RACE_ADMIN_TOKEN=""

# Where run records are written. On Cloud Run the default is ephemeral — point
# this at a mounted volume before treating the records as an audit trail.
# RACE_DATA_DIR="/var/race-data"

# Keep raw vendor payloads in the run record for debugging. Credentials are
# redacted on the way to disk regardless. Off by default.
# RACE_KEEP_RAW="false"
# Put the email address in the run index as well as the subject map. Off by
# default so the operational log is readable without being a list of people.
# RACE_LOG_EMAIL="false"

# ------------------------------------------------------------------- storage
# Firestore is used automatically when the Cloud Run service account can reach
# it — project and database id are read from firebase-applet-config.json, which
# AI Studio's Firebase integration writes. Nothing to set for the happy path.
# If Firestore is unreachable the engine falls back to the container filesystem
# and says so in /api/race/status. That fallback does NOT survive a redeploy.
# RACE_FIRESTORE_DB=""            # override the database id
# RACE_FORCE_FILESYSTEM="false"   # skip Firestore entirely

# Apify — step 3 only. Without it, step 3 refuses to start rather than
# pretending. Actors bill per result row, so the cost of a run is only known
# once it finishes and is read back from the run, never estimated.
APIFY_TOKEN=""
# RACE_SCRAPE_MAX_ITEMS="1000"     # per actor; a runaway guard, not a budget
# RACE_SCRAPE_CONCURRENCY="3"
# RACE_SCRUB_SCRAPED="false"       # true strips third-party identifiers from
                                   # scraped items — off per the standing
                                   # "keep everything until Legal reviews" call
