{
  "entities": {
    "ContactInquiry": {
      "title": "Contact Inquiry",
      "description": "Prospective client consultation requests submitted through the Talk to Us modal",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the contact person",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Business email address",
          "maxLength": 150
        },
        "company": {
          "type": "string",
          "description": "Organization or enterprise name",
          "maxLength": 120
        },
        "interest": {
          "type": "string",
          "description": "Primary solution or engine interest",
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "description": "Details regarding the inquiry or business challenge",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of submission"
        },
        "status": {
          "type": "string",
          "description": "Workflow review status",
          "enum": [
            "new",
            "contacted",
            "archived"
          ]
        }
      },
      "required": [
        "name",
        "email",
        "company",
        "interest",
        "status"
      ]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Lead generation, acquisition and retention marketing campaign configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique campaign alphanumeric identifier",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Campaign descriptive title",
          "maxLength": 120
        },
        "industry": {
          "type": "string",
          "description": "Target vertical or sector",
          "maxLength": 100
        },
        "confidence": {
          "type": "string",
          "description": "Lead confidence qualification tier",
          "maxLength": 50
        },
        "budgetPerDay": {
          "type": "number",
          "description": "Daily expenditure allocation in INR"
        },
        "totalBudgetCap": {
          "type": "number",
          "description": "Maximum ceiling expenditure in INR"
        },
        "startDate": {
          "type": "string",
          "description": "Campaign operational launch date",
          "maxLength": 30
        },
        "endDate": {
          "type": "string",
          "description": "Campaign conclusion date",
          "maxLength": 30
        },
        "notes": {
          "type": "string",
          "description": "Strategic notes and brief",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Execution status of the campaign",
          "enum": [
            "Active",
            "Paused",
            "Draft",
            "Completed"
          ]
        },
        "createdAt": {
          "type": "string",
          "description": "Human readable creation timestamp",
          "maxLength": 50
        },
        "owner": {
          "type": "string",
          "description": "Name of campaign manager",
          "maxLength": 100
        },
        "ownerId": {
          "type": "string",
          "description": "Authenticated user UID who created the campaign",
          "maxLength": 128
        },
        "targetCAC": {
          "type": "number",
          "description": "Target cost per acquired prospect in INR"
        },
        "productSector": {
          "type": "string",
          "description": "Specific product category or offering",
          "maxLength": 100
        },
        "currentSpend": {
          "type": "number",
          "description": "Cumulative budget consumed to date in INR"
        },
        "leadsAcquired": {
          "type": "number",
          "description": "Total prospects acquired"
        }
      },
      "required": [
        "id",
        "name",
        "industry",
        "budgetPerDay",
        "totalBudgetCap",
        "status",
        "targetCAC"
      ]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Account details and system access permissions",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth unique user ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "description": "User full display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "User profile avatar URL",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "description": "Assigned access role in the system",
          "enum": [
            "admin",
            "manager",
            "viewer"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation ISO timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "role"
      ]
    },
    "RaceRun": {
      "title": "RACE Run Record",
      "description": "Execution record for identity resolution engine",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "description": "Unique run identifier",
          "maxLength": 128
        },
        "subjectId": {
          "type": "string",
          "description": "Resolved subject identifier",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "description": "Execution status of the run"
        },
        "startedAt": {
          "type": "string",
          "description": "Timestamp when run started"
        }
      },
      "required": [
        "runId",
        "status"
      ]
    },
    "RaceMeta": {
      "title": "RACE Metadata",
      "description": "Metadata for subject mapping and vendor spend ledger",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Metadata identifier"
        }
      }
    },
    "RaceTarget": {
      "title": "RACE Scrape Targets Plan",
      "description": "Step 2 target planning record for scrape operations",
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "description": "Target subject identifier"
        },
        "sourceRunId": {
          "type": "string",
          "description": "Step 1 run ID source"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when targets were planned"
        }
      },
      "required": [
        "subjectId",
        "sourceRunId"
      ]
    },
    "RaceScrape": {
      "title": "RACE Scrape Record",
      "description": "Scrape execution and actor run result data for a subject target",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "description": "Unique scrape document identifier"
        },
        "subjectId": {
          "type": "string",
          "description": "Target subject identifier"
        },
        "targetId": {
          "type": "string",
          "description": "Identifier of the target surface being scraped"
        },
        "actor": {
          "type": "string",
          "description": "Apify or vendor actor used for scraping"
        },
        "status": {
          "type": "string",
          "description": "Execution status of the scrape operation"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when scrape was executed"
        }
      },
      "required": [
        "subjectId"
      ]
    },
    "RacePersona": {
      "title": "RACE Persona Record",
      "description": "Synthesized profile, persona attributes, and scoring for a resolved subject",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "description": "Unique persona document identifier or subject ID"
        },
        "subjectId": {
          "type": "string",
          "description": "Target subject identifier"
        },
        "status": {
          "type": "string",
          "description": "Status of the persona generation"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when persona was created or updated"
        }
      },
      "required": [
        "subjectId"
      ]
    },
    "RaceCategory": {
      "title": "RACE Category Ranking",
      "description": "Ranked categories for a subject, with the full scoring table including deprioritised candidates. Stops at the category \u2014 no brands, offers or mechanisms.",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "description": "Subject ID used as the document identifier"
        },
        "subjectId": {
          "type": "string",
          "description": "Target subject identifier"
        },
        "status": {
          "type": "string",
          "description": "running, completed or failed"
        },
        "model": {
          "type": "string",
          "description": "Model used for the derivation"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the ranking was produced"
        }
      },
      "required": [
        "subjectId"
      ]
    }
  },
  "firestore": {
    "/contact_inquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "Collection of client consultation requests from the marketing landing page"
    },
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Collection of marketing campaigns managed by authenticated team members"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user accounts with access roles"
    },
    "/race_runs/{runId}": {
      "schema": "RaceRun",
      "description": "Resolved identity run history records"
    },
    "/race_meta/{metaId}": {
      "schema": "RaceMeta",
      "description": "Metadata documents including subject mappings and spend ledger"
    },
    "/race_targets/{targetId}": {
      "schema": "RaceTarget",
      "description": "Planned scrape targets per subject"
    },
    "/race_scrapes/{docId}": {
      "schema": "RaceScrape",
      "description": "Collection of executed scrape records and target results"
    },
    "/race_personas/{docId}": {
      "schema": "RacePersona",
      "description": "Collection of generated persona records and behavioral profiles"
    },
    "/race_categories/{docId}": {
      "schema": "RaceCategory",
      "description": "Collection of ranked category records, including rejected candidates and the reason each lost"
    }
  }
}
